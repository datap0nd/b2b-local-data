# Local .env in the install folder; process environment overrides file settings.
# DG_GITHUB_TOKEN: the data-governance GitHub token (Contents: read on this private repo).
# Usually already present as an environment variable; set it here only if it is not.
# Never sent to SQL or Qwen.
DG_GITHUB_TOKEN=
# Blank DB_KIND chooses postgres when PGURL (or PGHOST) is set, otherwise demo. DB_KIND=csv reads a local export.
# Work PCs with the data-governance variables PGHOST/PGPORT/PGDATABASE/PGUSER/PGPASSWORD and
# DG_AI_API_URL/DG_AI_API_KEY/DG_AI_MODEL need nothing below; values here take precedence when set.
DB_KIND=
PGURL=
RO_SQL_USER=
RO_SQL_PW=
# prefer = TLS without certificate checks when offered, plain otherwise (the data-governance behaviour);
# true = verified TLS only (DB_CA_FILE for an internal CA); false = no TLS.
DB_SSL=prefer
DB_CA_FILE=
DB_TIMEOUT_SECONDS=30
MAX_SOURCE_ROWS=100000
B2B_RAW_TABLE=bi_reporting.b2b_project
# DB_KIND=csv: a local Salesforce export with all 30 columns. Relative paths resolve from this .env folder.
B2B_CSV_PATH=
B2B_CSV_ENCODING=utf-8-sig
B2B_CACHE_SECONDS=60

# Model endpoint, key, and name. The environment variables LOCAL_AI_ENDPOINT, LOCAL_AI_API_KEY, and
# LOCAL_AI_MODEL are used when the LLM_* names below are blank (then the data-governance DG_AI_* names).
AI_PROVIDER=openai_compatible
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL_NAME=
# Exact hostnames/IPs of internal model servers using public-range addresses.
B2B_LLM_ALLOWED_HOSTS=
# Per-read timeout; streamed replies may take longer overall. Up to 900.
AI_TIMEOUT_SECONDS=120
# Like Scribble: stream the reply and honour the Windows/system proxy settings for the model endpoint.
B2B_LLM_STREAM=true
B2B_LLM_USE_SYSTEM_PROXY=true
APP_PORT=8765

# Defaults to <install-folder>/data; SQLite conversation history is local.
B2B_DATA_DIR=
B2B_INSTALL_ROOT=
B2B_AUTH_USER_HEADER=X-Forwarded-User
B2B_ALLOW_LOCALHOST_IDENTITY=true
# Optional authenticated reverse proxy. Keep blank for local use.
B2B_TRUSTED_PROXIES=
B2B_PROXY_SHARED_SECRET=
B2B_PUBLIC_ORIGIN=
