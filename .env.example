# Copy to .env in the install folder. Environment variables override this file.
# Plain KEY=value; optional matching quotes; no interpolation or inline comments.
DB_KIND=demo
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
# SQL Server: set DB_PORT=1433 and DB_AUTH=windows or password.
DB_AUTH=password
DB_SSL=true
DB_CA_FILE=
DB_TIMEOUT_SECONDS=30
MAX_SOURCE_ROWS=100000

# ollama or openai_compatible (vLLM, LM Studio, etc.). Use a LOCAL model.
AI_PROVIDER=ollama
AI_BASE_URL=http://127.0.0.1:11434
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_SECONDS=120
APP_PORT=8765
